# ==============================================================================
# EmergencyRoute AI - Environment Configuration Example
# ==============================================================================

# Core Project Settings
PROJECT_NAME="EmergencyRoute AI"
VERSION="1.0.0"
CITY="Phagwara, Punjab, India"
DEFAULT_LAT=31.2231
DEFAULT_LNG=75.7708
DEFAULT_SEARCH_RADIUS_METERS=6000

# Delhivery Maps Platform Configuration
# Leave blank to operate in local fallback mode (OpenStreetMap tiles + local routing)
DELHIVERY_API_KEY=""
DELHIVERY_BASE_URL="https://maps.delhivery.com/api/v1"
DELHIVERY_REQUEST_TIMEOUT_SECONDS=10.0
DELHIVERY_MAX_RETRIES=3
DELHIVERY_RETRY_BACKOFF_SECONDS=1.0

# OSRM (Open Source Routing Machine) Configuration
# Public demo server endpoint for independent external routing comparison
OSRM_BASE_URL="https://router.project-osrm.org"
OSRM_REQUEST_TIMEOUT_SECONDS=8.0

# TomTom Live Traffic & Maps Platform (Server-Side Only - Never Exposed to Frontend)
# Register for free at developer.tomtom.com (2,500 free requests/day)
TOMTOM_API_KEY=""

# Traffic Simulation & Telemetry Settings
# Options: 'synthetic', 'delhivery', 'hybrid'
TRAFFIC_PROVIDER_MODE="synthetic"

# API Server Settings
API_HOST="127.0.0.1"
API_PORT=8000
LOG_LEVEL="INFO"

